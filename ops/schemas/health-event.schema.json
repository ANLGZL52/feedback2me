{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://feedback2me/ops/health-event.schema.json",
  "title": "Feedback2Me Health Event",
  "description": "One operational health check result. OPERATIONAL METADATA ONLY — never feedback text, names, emails, tokens, keys, receipts (see ops/README PII policy).",
  "type": "object",
  "required": ["timestamp", "environment", "runId", "checkId", "status"],
  "additionalProperties": false,
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "environment": { "type": "string", "enum": ["production", "staging", "ci", "local", "simulation"] },
    "runId": { "type": "string", "description": "id of the monitor run that produced this event" },
    "checkId": { "type": "string", "description": "id from check-matrix.json" },
    "componentId": { "type": ["string", "null"], "description": "node-* id (component-inventory.json)" },
    "edgeId": { "type": ["string", "null"], "description": "e-*/r-* id (dependency-graph.json)" },
    "journeyId": { "type": ["string", "null"], "description": "j-* id (user-journeys.json)" },
    "status": { "type": "string", "enum": ["HEALTHY", "DEGRADED", "DOWN", "UNKNOWN", "CHECKING"] },
    "severity": { "type": ["string", "null"], "enum": ["P0", "P1", "P2", "info", null] },
    "latencyMs": { "type": ["number", "null"] },
    "httpStatus": { "type": ["integer", "null"] },
    "errorCode": { "type": ["string", "null"], "description": "operational code only, e.g. TIMEOUT, DNS, HTTP_503, RULES_DENY" },
    "releaseSha": { "type": ["string", "null"] },
    "appBuild": { "type": ["integer", "string", "null"] },
    "dependency": { "type": ["string", "null"] },
    "correlationId": { "type": ["string", "null"] },
    "message": { "type": ["string", "null"], "description": "short operational message, no PII" },
    "details": { "type": "object", "description": "operational metadata only; must not contain PII/secrets" }
  }
}
