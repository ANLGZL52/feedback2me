rules_version = '2';
// Bu dosyayı canlıya almak için (yoksa permission-denied alırsın):
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Uygulama linkTier: 'demo' | 'premium'. Eski kurallarda 'pro' kullanildiysa onu da kabul et.
    function linkTierAllowsPublicFeedback(link) {
      return !link.keys().hasAny(['linkTier'])
        || link.linkTier == 'premium'
        || link.linkTier == 'pro'
        || (link.linkTier == 'demo'
            && (!link.keys().hasAny(['demoSubmissionUsed']) || link.demoSubmissionUsed == false));
    }

    // === SÜRE: SERVER-AUTHORITATIVE (SIFIR TOLERANS) ===
    // Expiry, istemci saatiyle yazilan validUntil'a DEGIL, sunucu-yetkili
    // createdAt'e baglidir. createdAt create sirasinda `== request.time` sarti ile
    // serverTimestamp'e sabitlenir (backdate/postdate imkansiz). Boylece kotu
    // niyetli istemci Demo'yu 10 dk'dan, Premium'u 24 saatten uzun yapamaz.
    // Eski (tier'siz / createdAt'siz) linklerde validUntil'a geri dusulur.
    function tierExpiry(link) {
      return link.linkTier == 'demo'
        ? link.createdAt + duration.value(10, 'm')
        : link.createdAt + duration.value(24, 'h');
    }
    function isTieredWithCreatedAt(link) {
      return (link.linkTier == 'demo' || link.linkTier == 'premium' || link.linkTier == 'pro')
        && link.createdAt is timestamp;
    }
    function linkNotExpired(link) {
      return isTieredWithCreatedAt(link)
        ? request.time < tierExpiry(link)
        : (!link.keys().hasAny(['validUntil']) || request.time < link.validUntil);
    }

    // Feedback kabulu SUNUCU-yetkilidir: aktif + suresi dolmamis + tier limiti.
    // DEMO ATOMIC GUARANTEE: demo linke feedback ancak AYNI batch/transaction
    // icinde link demoSubmissionUsed=true + isActive=false yapiliyorsa kabul
    // edilir (getAfter = islem sonrasi durum). Yalniz feedback yazip linki acik
    // birakmaya calisan kotu niyetli istemci REDDEDILIR → demo tek-yorum garanti.
    function linkAcceptsPublicFeedback(linkId) {
      let linkPath = /databases/$(database)/documents/links/$(linkId);
      let link = get(linkPath).data;
      let after = getAfter(linkPath).data;
      return link.isActive == true
        && linkNotExpired(link)
        && linkTierAllowsPublicFeedback(link)
        && (link.linkTier != 'demo'
            || (after.demoSubmissionUsed == true && after.isActive == false));
    }

    // === Kullanici profili: kredi/premium/demo entitlement SUNUCU-yetkili ===
    function creditsOf(d) { return d.get('paidLinkCredits', 0); }
    function isPremiumOf(d) { return d.get('isPremium', false); }
    function premiumUntilOf(d) { return d.get('premiumUntil', null); }
    function demoUsedOf(d) { return d.get('freeDemoLinkUsed', false); }

    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function userExists(uid) { return exists(userDoc(uid)); }
    function creditsBefore(uid) { return userExists(uid) ? creditsOf(get(userDoc(uid)).data) : 0; }
    function demoUsedBefore(uid) { return userExists(uid) ? demoUsedOf(get(userDoc(uid)).data) : false; }

    // Link create AYNI atomic islemde entitlement'i dogru tuketmeli:
    //  - DEMO: freeDemoLinkUsed false→true (bir ucretsiz demo hakki; ikinci demo DENY).
    //  - PREMIUM: kredi before>=1 && after == before-1 (1 kredi = 1 premium link).
    //    Guncel is modeli SALT-KREDI (subscription YOK; backend isPremium GRANT
    //    ETMEZ, yalnizca paidLinkCredits verir → functions/src/index.ts). Bu yuzden
    //    eski isPremium bypass'i KALDIRILDI: her premium link create kredi tuketir.
    function linkCreateConsumesEntitlement(link) {
      let uid = link.ownerId;
      let tier = link.get('linkTier', 'demo');
      let after = getAfter(userDoc(uid)).data;
      return tier == 'demo'
        ? (demoUsedBefore(uid) == false && demoUsedOf(after) == true)
        : (userExists(uid)
            && creditsBefore(uid) >= 1
            && creditsOf(after) == creditsBefore(uid) - 1);
    }

    // Owner link update'i lifecycle'i GERIYE alamaz: sahip/kod/tier/createdAt/
    // validUntil/demoSubmissionUsed degisemez; kapali link (isActive=false)
    // yeniden ACILAMAZ. Tek izin verilen yon aktif→pasif (deactivate).
    // Expired/consumed link immutable → owner yeni link olusturmali.
    function ownerLinkUpdateIsSafe(prev, next) {
      return next.ownerId == prev.ownerId
        && next.code == prev.code
        && next.get('linkTier', '') == prev.get('linkTier', '')
        && next.get('createdAt', null) == prev.get('createdAt', null)
        && next.get('validUntil', null) == prev.get('validUntil', null)
        && next.get('demoSubmissionUsed', false) == prev.get('demoSubmissionUsed', false)
        && !(prev.isActive == false && next.isActive == true);
    }

    // Istemci kendi user dokumanini guncelleyebilir ama kredi/premium/demo
    // hakkini YUKSELTEMEZ (yalniz tuketim = azaltma serbest).
    function noPrivilegeEscalation(prev, next) {
      return creditsOf(next) <= creditsOf(prev)                       // kredi yalnizca azalir
        && isPremiumOf(next) == isPremiumOf(prev)                     // premium bayragi istemciden degismez
        && premiumUntilOf(next) == premiumUntilOf(prev)               // premium suresi uzatilamaz
        && !(demoUsedOf(prev) == true && demoUsedOf(next) == false);  // demo hakki sifirlanamaz
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Ilk olusturma: kredi 0 + premium kapali (kendine kredi/premium ile baslayamaz).
      allow create: if request.auth != null && request.auth.uid == userId
        && creditsOf(request.resource.data) == 0
        && isPremiumOf(request.resource.data) == false;
      allow update: if request.auth != null && request.auth.uid == userId
        && noPrivilegeEscalation(resource.data, request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sunucu-yetkili IAP kayitlari (makbuz tekilligi / replay korumasi).
    // Istemci erisimi YOK; yalnizca Admin SDK yazar/okur (kurallari bypass eder).
    match /processedPurchases/{purchaseKey} {
      allow read, write: if false;
    }
    match /links/{linkId} {
      // Aktif linkler + tukenmis demo (tek kullanim sonrasi mesaj icin isActive=false).
      allow read: if resource.data.isActive == true
        || (resource.data.keys().hasAny(['linkTier']) && resource.data.linkTier == 'demo'
            && resource.data.keys().hasAny(['demoSubmissionUsed'])
            && resource.data.demoSubmissionUsed == true);
      // Create: kendi adina + createdAt server-authoritative (== request.time) +
      // entitlement (kredi/demo hakki) ayni atomic islemde dogru tuketilmis.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId is string
        && request.resource.data.code is string
        && request.resource.data.createdAt == request.time
        && linkCreateConsumesEntitlement(request.resource.data);
      // Owner: yalnizca guvenli update (reactivate/uzatma/reset yasak) + delete.
      allow update: if request.auth != null && request.auth.uid == resource.data.ownerId
        && ownerLinkUpdateIsSafe(resource.data, request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      // Demo: tek yorum sonrasi misafir batch (yorum + link kapatma).
      allow update: if resource.data.linkTier == 'demo'
        && resource.data.demoSubmissionUsed == false
        && request.resource.data.linkTier == resource.data.linkTier
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.code == resource.data.code
        && request.resource.data.validUntil == resource.data.validUntil
        && request.resource.data.demoSubmissionUsed == true
        && request.resource.data.isActive == false
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['demoSubmissionUsed', 'isActive']);
    }
    match /feedbacks/{feedbackId} {
      allow create: if request.resource.data.keys().hasAll(['linkId', 'textRaw'])
        && request.resource.data.textRaw is string
        && request.resource.data.textRaw.size() >= 10
        && linkAcceptsPublicFeedback(request.resource.data.linkId);
      allow read, update, delete: if request.auth != null;
    }
  }
}
