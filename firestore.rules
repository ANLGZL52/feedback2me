rules_version = '2';
// Bu dosyayı canlıya almak için (yoksa permission-denied alırsın):
//   firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Uygulama linkTier: 'demo' | 'premium'. Eski kurallarda 'pro' kullanildiysa onu da kabul et.
    function linkTierAllowsPublicFeedback(link) {
      return !link.keys().hasAny(['linkTier'])
        || link.linkTier == 'premium'
        || link.linkTier == 'pro'
        || (link.linkTier == 'demo'
            && (!link.keys().hasAny(['demoSubmissionUsed']) || link.demoSubmissionUsed == false));
    }

    function linkAcceptsPublicFeedback(linkId) {
      let link = get(/databases/$(database)/documents/links/$(linkId)).data;
      return link.isActive == true
        && (!link.keys().hasAny(['validUntil']) || request.time < link.validUntil)
        && linkTierAllowsPublicFeedback(link);
    }

    // --- Kullanıcı profili: kredi/premium alanları SUNUCU-yetkilidir ---
    // Kredi verme yalnızca Cloud Function (Admin SDK) üzerinden olur; Admin SDK
    // güvenlik kurallarını BYPASS eder. İstemci kendi dokümanını güncelleyebilir
    // ama kredi/premium'u YÜKSELTEMEZ (yalnızca tüketim = azaltma serbest).
    function creditsOf(d) { return d.get('paidLinkCredits', 0); }
    function isPremiumOf(d) { return d.get('isPremium', false); }
    function premiumUntilOf(d) { return d.get('premiumUntil', null); }
    function demoUsedOf(d) { return d.get('freeDemoLinkUsed', false); }

    function noPrivilegeEscalation(prev, next) {
      return creditsOf(next) <= creditsOf(prev)                       // kredi yalnızca azalır (link tüketimi)
        && isPremiumOf(next) == isPremiumOf(prev)                     // premium bayrağı istemciden değişemez
        && premiumUntilOf(next) == premiumUntilOf(prev)               // premium süresi uzatılamaz
        && !(demoUsedOf(prev) == true && demoUsedOf(next) == false);  // demo hakkı sıfırlanamaz
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // İlk oluşturma: kredi 0 + premium kapalı (kendine kredi/premium ile başlayamaz).
      allow create: if request.auth != null && request.auth.uid == userId
        && creditsOf(request.resource.data) == 0
        && isPremiumOf(request.resource.data) == false;
      allow update: if request.auth != null && request.auth.uid == userId
        && noPrivilegeEscalation(resource.data, request.resource.data);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sunucu-yetkili IAP kayıtları (makbuz tekilliği / replay koruması).
    // İstemci erişimi YOK; yalnızca Admin SDK yazar/okur (kuralları bypass eder).
    match /processedPurchases/{purchaseKey} {
      allow read, write: if false;
    }
    match /links/{linkId} {
      // Aktif linkler + tükenmiş demo (tek kullanım sonrası mesaj için isActive=false).
      allow read: if resource.data.isActive == true
        || (resource.data.keys().hasAny(['linkTier']) && resource.data.linkTier == 'demo'
            && resource.data.keys().hasAny(['demoSubmissionUsed'])
            && resource.data.demoSubmissionUsed == true);
      // Sadece oturum açmış kullanıcı kendi adına link oluşturabilir.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId is string
        && request.resource.data.code is string;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
      // Demo: tek yorum sonrasi misafir batch (yorum + link kapatma).
      allow update: if resource.data.linkTier == 'demo'
        && resource.data.demoSubmissionUsed == false
        && request.resource.data.linkTier == resource.data.linkTier
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.code == resource.data.code
        && request.resource.data.validUntil == resource.data.validUntil
        && request.resource.data.demoSubmissionUsed == true
        && request.resource.data.isActive == false
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['demoSubmissionUsed', 'isActive']);
    }
    match /feedbacks/{feedbackId} {
      allow create: if request.resource.data.keys().hasAll(['linkId', 'textRaw'])
        && request.resource.data.textRaw is string
        && request.resource.data.textRaw.size() >= 10
        && linkAcceptsPublicFeedback(request.resource.data.linkId);
      allow read, update, delete: if request.auth != null;
    }
  }
}
